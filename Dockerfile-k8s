# Multi-stage Dockerfile for Nuxt2 production build

# Stage 1: Dependencies
FROM node:16-alpine AS deps
WORKDIR /app

# Install build dependencies for native modules
RUN apk add --no-cache \
    autoconf \
    automake \
    libtool \
    make \
    g++ \
    python3 \
    nasm \
    libpng-dev \
    libjpeg-turbo-dev \
    giflib-dev \
    libwebp-dev

# Copy package files
COPY package.json yarn.lock ./

# Install dependencies
RUN yarn install --frozen-lockfile --production=false

# Stage 2: Builder
FROM node:16-alpine AS builder
WORKDIR /app

# Accept build arguments
ARG API_BASE_URL
ARG APP_NAME

# Copy dependencies from deps stage
COPY --from=deps /app/node_modules ./node_modules

# Copy application files
COPY . .

# Build the application with environment variables
ENV API_BASE_URL=${API_BASE_URL}
ENV APP_NAME=${APP_NAME}
RUN yarn build

# Stage 3: Runner
FROM node:16-alpine AS runner
WORKDIR /app

# Set environment to production
ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=3000

# Install build dependencies temporarily and runtime libraries permanently
RUN apk add --no-cache --virtual .build-deps \
    autoconf \
    automake \
    libtool \
    make \
    g++ \
    python3 \
    nasm \
    && apk add --no-cache \
    libpng \
    libjpeg-turbo \
    giflib \
    libwebp

# Install only production dependencies
COPY package.json yarn.lock ./
RUN yarn install --frozen-lockfile --production=true && yarn cache clean

# Remove build dependencies to reduce image size
RUN apk del .build-deps

# Copy built application from builder
COPY --from=builder /app/.nuxt ./.nuxt
COPY --from=builder /app/static ./static
COPY --from=builder /app/nuxt.config.js ./nuxt.config.js
COPY --from=builder /app/content ./content
COPY --from=builder /app/utils ./utils
COPY --from=builder /app/api ./api
COPY --from=builder /app/middleware ./middleware
COPY --from=builder /app/plugins ./plugins
COPY --from=builder /app/layouts ./layouts
COPY --from=builder /app/pages ./pages
COPY --from=builder /app/locales ./locales
COPY --from=builder /app/store ./store
COPY --from=builder /app/assets ./assets
COPY --from=builder /app/components ./components

# Create a non-root user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nuxtjs && \
    chown -R nuxtjs:nodejs /app

USER nuxtjs

# Expose port 3000
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD node -e "require('http').get('http://localhost:3000/api/health', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})"

# Start the application
CMD ["yarn", "start"]
